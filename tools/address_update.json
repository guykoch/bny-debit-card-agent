{
  "name": "address_update",
  "access": "write",
  "ticket": true,
  "description": "Send an Address Update ticket to the Service Center. The address on file does not change until it is processed.",
  "input_schema": {
    "type": "object",
    "properties": {
      "client_id": {
        "type": "string",
        "description": "Client identifier returned by find_client."
      },
      "account_id": {
        "type": "string",
        "description": "Account identifier returned by list_accounts."
      },
      "draft_id": {
        "type": "string",
        "description": "Set by the system; one per review card (no duplicate tickets)."
      },
      "subject": {
        "type": "string",
        "description": "Subject/Attention."
      },
      "additional_info": {
        "type": "string",
        "description": "Additional Information (the advisor's own words)."
      },
      "callback": {
        "type": "object",
        "description": "Call Back #: {kind: US | Non-US, number, ext}."
      },
      "attachments": {
        "type": "array",
        "description": "Optional files: {storage_id, name, size, type}."
      },
      "new_address": {
        "type": "array",
        "description": "Up to 4 address lines, from the address search."
      },
      "new_state": {
        "type": "string",
        "description": "Set by the system from the address search."
      },
      "new_country": {
        "type": "string",
        "description": "Set by the system from the address search."
      },
      "new_phone": {
        "type": "string",
        "description": "New phone number."
      }
    },
    "required": [
      "client_id",
      "callback",
      "draft_id"
    ]
  }
}