{
  "name": "stop_payment",
  "access": "write",
  "ticket": true,
  "description": "Send a Stop Payment ticket to the Service Center (it changes nothing else).",
  "input_schema": {
    "type": "object",
    "properties": {
      "client_id": {
        "type": "string",
        "description": "Client identifier returned by find_client."
      },
      "account_id": {
        "type": "string",
        "description": "Account identifier returned by list_accounts."
      },
      "draft_id": {
        "type": "string",
        "description": "Set by the system; one per review card (no duplicate tickets)."
      },
      "subject": {
        "type": "string",
        "description": "Subject/Attention."
      },
      "additional_info": {
        "type": "string",
        "description": "Additional Information (the advisor's own words)."
      },
      "callback": {
        "type": "object",
        "description": "Call Back #: {kind: US | Non-US, number, ext}."
      },
      "attachments": {
        "type": "array",
        "description": "Optional files: {storage_id, name, size, type}."
      },
      "checks": {
        "type": "array",
        "description": "Check rows: {check_number, amount, date_written}."
      }
    },
    "required": [
      "client_id",
      "account_id",
      "checks",
      "callback",
      "draft_id"
    ]
  }
}